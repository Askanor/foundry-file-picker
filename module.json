{
  "id": "foundry-file-picker",
  "title": "Foundry File Picker",
  "description": "Adds hover previews and multi-file upload to Foundry's file picker, and a sidebar tab with a file browser.",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14.369"
  },
  "authors": [
    {
      "name": "Askanor"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/foundry-file-picker.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "url": "https://github.com/Askanor/foundry-file-picker",
  "manifest": "https://github.com/Askanor/foundry-file-picker/releases/latest/download/module.json",
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang"]
    }
  }
}
